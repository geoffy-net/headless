{
  "compilerOptions": {
    "target": "ES2022",
    // DOM rather than @types/node on purpose: this package must compile for an edge
    // runtime as well as Node, and fetch / AbortController / crypto.subtle / Response
    // are the web globals both provide.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
